@model MediaWiz.Forums.Models.ForgotPasswordViewModel
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Services
@using MediaWiz.Forums.Extensions
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Umbraco.Cms.Web.Common
@{
    var displayStyle = "";
    if (TempData["HideForm"] != null && (bool)TempData["HideForm"])
    {
        displayStyle = "display: none;";
    }
}
@if (TempData["ResetSent"] != null && (bool)TempData["ResetSent"] == true)
{
    <h2>@Model.RequestSentTitle</h2>
    <p>@Model.RequestSentMessage</p>
    return;
}
<div class="mb-3" id="forgotten-submit" style="@displayStyle">
    @using (Html.BeginUmbracoForm("ForgotPassword", "ForumsSurface", null, new { @id = "forgot-form-id", @class="needs-validation", novalidate="" }, FormMethod.Post))
    {
        <hr />
        <div class="mb-3 col-sm-4">
            <label asp-for="@Model.Model.EmailAddress" class="form-label"></label>
            <input asp-for="@Model.Model.EmailAddress" class="form-control" autocomplete="new-password" aria_required="true" required />
            <span asp-validation-for="@Model.Model.EmailAddress" class="invalid-feedback"></span>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="submit" value="@Model.SendButtonText" class="btn btn-dark" />
    }
</div>

