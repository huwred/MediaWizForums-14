@using Umbraco.Cms.Core.Services
@using MediaWiz.Forums.Extensions
@using Umbraco.Cms.Web.Common

@{
    string activesince = Context.Request.Query["TopicsSince"];
    activesince ??= "7d";
}
<form action="@Context.Request.Path" class="col-10 offset-1" id="topics-since">
    <div class="row mb-3">
        <div class="col-6">
            <label class="form-label pt-2">@umbracoHelper.GetDictionaryValueOrDefault("Forums.ActiveSince", "Within the")</label>
            <select class="form-select" name="TopicsSince" id="active-since">
                <option value="60m" selected-val="@activesince">@umbracoHelper.GetDictionaryValueOrDefault("Forums.ActiveSince.LastHour", "Last hour")</option>
                <option value="1d" selected-val="@activesince">@umbracoHelper.GetDictionaryValueOrDefault("Forums.ActiveSince.Yesterday", "Yesterday")</option>
                <option value="7d" selected-val="@activesince">@umbracoHelper.GetDictionaryValueOrDefault("Forums.ActiveSince.LastWeek", "Last week")</option>
                <option value="1m" selected-val="@activesince">@umbracoHelper.GetDictionaryValueOrDefault("Forums.ActiveSince.LastMonth", "Last month")</option>
                <option value="1y" selected-val="@activesince">@umbracoHelper.GetDictionaryValueOrDefault("Forums.ActiveSince.LastYear", "Last year")</option>
            </select>
        </div>
        <div class="col-4">
            <label class="form-label pt-2">Filter By</label>
            <select class="form-select" name="showonly" id="active-filter">
                <option value="" selected-val="@activesince">@umbracoHelper.GetDictionaryValueOrDefault("Forums.ActiveSince.ANy", "All")</option>
                <option value="noreply" selected-val="@activesince">@umbracoHelper.GetDictionaryValueOrDefault("Forums.ActiveSince.Noreply", "No replies")</option>
                <option value="solved" selected-val="@activesince">@umbracoHelper.GetDictionaryValueOrDefault("Forums.ActiveSince.Solved", "Solved")</option>
                <option value="unsolved" selected-val="@activesince">@umbracoHelper.GetDictionaryValueOrDefault("Forums.ActiveSince.Unsolved", "Un-Solved")</option>
            </select>
        </div>
    </div>
</form>

