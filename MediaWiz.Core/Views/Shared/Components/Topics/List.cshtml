@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using MediaWiz.Forums.Interfaces
@using Umbraco.Cms.Core.Services
@using Umbraco.Extensions
@using MediaWiz.Forums.Extensions

@inject IForumCacheService _cacheService
@{
    int.TryParse(Context.Request.Query["page"], out var pagenum);
    var posts = Model.Children().Where(x => x.IsDocumentType("Forumpost")).ToList();
    if(pagenum == 0){ pagenum = 1; }
    var pageSize = Model.HasValue("intPageSize") ? Convert.ToInt32(Model.Value("intPageSize")) : 5;
    var totalPages = (int)Math.Ceiling((double)posts.Count() / (double)pageSize);
    ViewBag.Page = pagenum;
    ViewBag.TotalPages = totalPages;
    if (posts.Any())
    {
        <div>
            <div class="wiz-topics">
                <div class="d-flex flex-row flex-wrap mb-3 p-2 color_dark bold">
                    <div class="col-6">@await DictionaryService.GetOrCreateDictionaryValue("Forums.Topic", "Topic")</div>
                    <div class="col-1">@await DictionaryService.GetOrCreateDictionaryValue("Forums.Replies", "Replies")</div>
                    <div class="col-1">@await DictionaryService.GetOrCreateDictionaryValue("Forums.Views", "Views")</div>
                    <div class="col-3">@await DictionaryService.GetOrCreateDictionaryValue("Forums.Activity", "Activity")</div>
                </div>
                <div class="wiz-body m-0 mb-2">
                    @{
                        var orderedposts = posts
                        .OrderByDescending(x => x.Value<int>("stickiness")) //Sticky First
                        .ThenByDescending(x => _cacheService.GetPost(x, "Topic_" + x.Id).latestPost)
                        .ThenByDescending(x => x.CreateDate);
                    }
                    @foreach (var post in orderedposts
                    .Skip((pagenum - 1) * pageSize).Take(pageSize))
                    {
                        @await Component.InvokeAsync("Posts",new {Template = "DisplayTopic",Model = post,showTitle = true})
                    }
                </div>
            </div>
            @if (totalPages > 1)
            {
                @await Component.InvokeAsync("Navigation",new {Template = "PagerView", Model = Model})
            }
        </div>
    }
    else if (Model.HasValue("postAtRoot") && Model.Value<int?>("postAtRoot") == 1)
    {
        <div>
            <div class="wiz-topics">
                <div class="d-flex flex-row flex-wrap mb-3 p-2 color_dark bold">
                    <div class="col-6">@await DictionaryService.GetOrCreateDictionaryValue("Forums.Topic", "Topic")</div>
                    <div class="col-3">@await DictionaryService.GetOrCreateDictionaryValue("Forums.Replies", "Replies")</div>
                    <div class="col-1">@await DictionaryService.GetOrCreateDictionaryValue("Forums.Views", "Views")</div>
                </div>
                <div class="wiz-body m-0 mb-2">
                    <div class="d-flex wiz-topic-title col-sm-12 align-center">
                        @await DictionaryService.GetOrCreateDictionaryValue("Forums.NoPosts", "No posts yet, be the first to make one.")
                    </div>
                </div>
            </div>
        </div>
    }
}


