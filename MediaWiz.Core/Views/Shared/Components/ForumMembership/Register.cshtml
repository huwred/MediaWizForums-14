@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using MediaWiz.Forums.Controllers
@using MediaWiz.Forums.Extensions
@using MediaWiz.Forums.Helpers
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.Extensions.Options
@using Umbraco.Cms.Core.Configuration.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Services
@using Umbraco.Cms.Web.Website.Models
@using Umbraco.Extensions

@inject MemberModelBuilderFactory memberModelBuilderFactory;
@inject IOptions<GlobalSettings> hostingSettings
@inject IOptions<ForumConfigOptions> forumOptions

@{
    var noCaptcha = ViewBag.NoCaptcha == true;
    // Build a registration model with parameters
    var registerModel = memberModelBuilderFactory
        .CreateRegisterModel()
        .WithMemberTypeAlias(forumOptions.Value.MemberTypeAlias ?? "forumMember")
        .WithRedirectUrl(null)
        .WithCustomProperties(true)
        .UsernameIsEmail(false)
        .Build();
    var useCaptcha = Model.Value<bool>("useCaptcha");
    var success = TempData["FormSuccess"] != null;
    var _hostingSettings = hostingSettings.Value;
    var warningMsg = DictionaryService.GetOrCreateDictionaryValue("Forums.Members.Register.Emailwarning", "The email will be coming from {0} so please add this domain to your whitelist. Should you not receive your validation email, please post on the Our Umbraco forums");
}


@if (success)
{
    @* This message will show if registerModel.RedirectUrl is not defined (default) *@
    <p class="text-success">@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.Register.Success","Your Registration was successful, you should now receive an email containing a validation link to verify your email address.")</p>
    <p>@String.Format(warningMsg,_hostingSettings.Smtp.From)</p>
}
else
{
    @if (useCaptcha && !noCaptcha)
    {
        
        <div id="captchaimage-div">
            @await Component.InvokeAsync("Captcha")
        </div>
    }

    using (Html.BeginUmbracoForm<ForumMemberController>("RegisterMe", null, new { @id = "register-form-id", style = "display:none", autocomplete = "off", @class = "w-75 mx-auto needs-validation mt-5", novalidate="" }, FormMethod.Post))
    {
        <div class="row gy-3 gy-md-4 overflow-hidden">
        <div class="col-12 gy-1">
            <label asp-for="@registerModel.Name" class="form-label"></label>
                <input asp-for="@registerModel.Name" class="form-control" autocomplete="off" aria_required="true" placeholder="Full name" required />
                <span asp-validation-for="@registerModel.Name" class="invalid-feedback"></span>
        </div>
            <div class="col-12 gy-2">
            <label asp-for="@registerModel.Username" class="form-label"></label>
            <input title="The Username field is required." asp-for="@registerModel.Username" class="form-control" autocomplete="off" aria_required="true" required aria-describedby="UsernameFeedback"/>
                <div id="UsernameFeedback" class="invalid-feedback">
                    The Username field is required.
                </div>
        </div>
        <div class="col-12 gy-2">
            <label asp-for="@registerModel.Email" class="form-label"></label>
                <input asp-for="@registerModel.Email" class="form-control" autocomplete="off" aria_required="true" type="email" required />
                <span asp-validation-for="@registerModel.Email" class="invalid-feedback"></span>
        </div>
        <div class="col-12 gy-2">
            <label asp-for="@registerModel.Password" class="form-label"></label>
            <input asp-for="@registerModel.Password" class="form-control" autocomplete="new_password" type="password" aria_required="true" required />
            <span asp-validation-for="@registerModel.Password" class="invalid-feedback"></span>
        </div>
        <div class="col-12 gy-2">
            <label asp-for="@registerModel.ConfirmPassword" class="form-label"></label>
                <input asp-for="@registerModel.ConfirmPassword" class="form-control" autocomplete="new-password" type="password" aria_required="true" required />
        </div>

        @if (registerModel.MemberProperties != null)
        {
            for (var i = 0; i < registerModel.MemberProperties.Count; i++)
            {
                if (registerModel.MemberProperties[i].Alias == "receiveNotifications")
                {

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" name="receiveNotifications" type="checkbox" id="receiveNotifications" value="@registerModel.MemberProperties[i].Value">
                            <label class="form-check-label" for="receiveNotifications">@Html.LabelFor(m => registerModel.MemberProperties[i].Value, registerModel.MemberProperties[i].Name)</label>
                        </div>
                        <div id="notifyHelp" class="form-text">
                            @DictionaryService.GetOrCreateDictionaryValue("Forums.Profile.NotifyHelp","Receive an email when someone posts on the forum.")
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-12 gy-2">
                        <label asp-for="@registerModel.MemberProperties[i].Name" class="form-label"></label>
                        <input asp-for="@registerModel.MemberProperties[i].Value" class="form-control"/>
                        <input asp-for="@registerModel.MemberProperties[i].Alias" type="hidden"/>
                    </div>
                }
            }
        }
        <div class="col-12">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="" name="iAgree" id="iAgree" required title="Agree to Terms">
                <label class="form-check-label text-secondary" for="iAgree">
                    I agree to the <a href="@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.TermsUrl", "/Terms")" class="link-primary text-decoration-none">terms and conditions</a>
                </label>
                <div class="invalid-feedback">
                    You must agree before submitting.
                </div>
            </div>
        </div>

        <div class="col-12 gy-2">
            <div class="d-grid">
                <button class="btn btn-lg btn-secondary" type="submit" id="register-submit">@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.Register", "Sign up")</button>
            </div>
        </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        </div>
        <div class="row">
            <div class="col-12">
                <hr class="mt-5 mb-4 border-secondary-subtle">
                <div class="col-12">
                    <p class="m-0 text-secondary text-center">Already have an account? <a href="/login" class="link-primary text-decoration-none">Sign in</a></p>
                </div>
            </div>
        </div>
    }

}
<storecontent asp-key="script-block">
    <script type="text/javascript" id="registerJs">
        document.addEventListener("DOMContentLoaded", (event) => {
            if ("@useCaptcha".toLowerCase() === "false" || "@noCaptcha".toLowerCase() == "true") {
                $('#register-form-id').show();
            }
            if ("@success".toLowerCase() === "true") {
                $(".forum-intro").hide();
            }
        });
        (function () {
          'use strict'

          // Fetch all the forms we want to apply custom Bootstrap validation styles to
          var forms = document.querySelectorAll('.needs-validation')

          // Loop over them and prevent submission
          Array.prototype.slice.call(forms)
            .forEach(function (form) {
              form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                  event.preventDefault()
                  event.stopPropagation()
                }

                form.classList.add('was-validated')
              }, false)
            })
        })()
    </script>
</storecontent>
