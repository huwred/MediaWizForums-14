@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Examine.Search
@using MediaWiz.Forums.Helpers
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Security
@using Umbraco.Cms.Core.Services
@using MediaWiz.Forums.Extensions
@using Examine
@using Umbraco.Extensions
@using Umbraco.Cms.Infrastructure.Examine
@inject IMemberService memberService
@inject IExamineManager examineManager

@{
    var ForumUrl = await DictionaryService.GetOrCreateDictionaryValue("Forums.ForumUrl", "/");
    ForumUrl = ForumUrl.TrimEnd('/');
    // Use Examine to search for members with a verified account
    var AllUsers = new List<IMember>();

    var memberSearcher = examineManager.TryGetIndex("ForumMemberIndex", out var memberIndex) ? memberIndex.Searcher : null;
    if (memberSearcher != null)
    {
        var criteria = memberSearcher.CreateQuery()
            .Field("hasVerifiedAccount", 1)
            .OrderByDescending(new SortableField("postCount", SortType.Int));
        var results = criteria.Execute();
        var memberIds = results.Select(x => int.Parse(x.Id)).ToArray();
        if (memberIds.Any())
        {
            AllUsers = memberService.GetAllMembers(memberIds).OrderByDescending(x => x.GetValue<int>("postCount")).ToList();
        }
    }

    var totalMembers = AllUsers.Count();

    int.TryParse(Context.Request.Query["page"], out var pagenum);
    var pageSize = (int?)TempData["PageSize"]  ?? 10;
    var totalPages = (int)Math.Ceiling((double)totalMembers / (double)pageSize);
    ViewBag.Page = pagenum;
    ViewBag.TotalPages = totalPages;
    var sortby = Context.Request.Query["sort"].ToString();
    string sortdir = Context.Request.Query["dir"].ToString();
    if (sortby == null)
    {
        sortby = "postCount";
        sortdir = "desc";
    }
    switch (sortdir)
    {
        case "asc":
            AllUsers = sortby == "Name" ? new List<IMember>(AllUsers.OrderBy(x => x.Name)) : new List<IMember>(AllUsers.OrderBy(x => x.GetValue(sortby)));
            sortdir = "desc";
            break;
        case "desc":
            AllUsers = sortby == "Name" ? new List<IMember>(AllUsers.OrderByDescending(x => x.Name)) : new List<IMember>(AllUsers.OrderByDescending(x => x.GetValue(sortby)));
            sortdir = "asc";
            break;

    }
    var currentUser = memberManager.GetCurrentMemberAsync().Result;
    IList<string> roles = new List<string>();
    if (currentUser != null)
    {
        roles = memberManager.GetRolesAsync(currentUser).Result;
    }

}

<table class="table">
    <thead>
        <tr>
            <th scope="col"><a href="@ForumUrl/members/?page=@pagenum&sort=Name&dir=@sortdir" class="@if(sortby == "Name") { <text>active</text> } @sortdir">@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.Name","Name")</a></th>
            <th scope="col"><a href="@ForumUrl/members/?page=@pagenum&sort=CreateDate&dir=@sortdir" class="@if(sortby == "CreateDate") { <text>active</text> } @sortdir">@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.CreateDate","Member Since")</a></th>
            <th scope="col"><a href="@ForumUrl/members/?page=@pagenum&sort=umbracoMemberLastLogin&dir=@sortdir" class="@if(sortby == "umbracoMemberLastLogin") { <text>active</text> } @sortdir">@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.Lastvisit","Last Visit")</a></th>
            <th scope="col">@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.Posts", "Posts")</th>
            <th scope="col">@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.Status", "Status")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (IMember member in AllUsers.Skip((pagenum - 1) * pageSize).Take(pageSize))
        {
            var user = memberManager.FindByNameAsync(member.Username).Result;
            IPublishedContent Pmember = memberManager.AsPublishedMember(user);
            long postcount = member.GetValue<long>("postCount");

            <tr>
                <td>@member.Name</td>
                <td>@member.CreateDate.ToDisplayDate()</td>
                @if (user.LastLoginDate != null)
                {
                    <td><span title="@user.LastLoginDate">@user.LastLoginDate.Value.GetRelativeDate()</span></td>

                }
                else
                {
                    <td>&nbsp;</td>
                }
                <td class="post-count">@postcount</td>
                <td>
                    @if (user.IsLockedOut)
                    {

                        @if (roles.Contains("ForumAdministrator"))
                        {
                            <a href="#" data-mode="unlock" data-userid="@user.Id" class="lock-user" title="@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.Unlock", "UnLock user")"><i class="bi bi-unlock fs-5"></i></a>
                        }
                        else
                        {
                            <i class="bi bi-lock fs-5" title="@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.Locked", "Account locked")"></i>
                        }
                    }
                    else
                    {
                        @if (user.LastLoginDate.HasValue && user.LastLoginDate.Value > DateTime.UtcNow.AddMinutes(-10))
                        {
                            <i class="bi bi-person-check fs-5" title="@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.Online", "User is online")"></i>
                        }
                        else
                        {
                            <i class="bi bi-person fs-5" title="@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.Offline", "User is offline")"></i>
                        }
                        @if (roles.Contains("ForumAdministrator"))
                        {
                            <a href="#" data-mode="lock" data-userid="@user.Id" title="@DictionaryService.GetOrCreateDictionaryValue("Forums.Members.Lock", "Lock user")" class="lock-user"><i class="bi bi-lock fs-5"></i></a>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
@if (totalPages > 1)
{
    @await Component.InvokeAsync("Navigation",new {Template = "PagerView"})
}