<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Version>17.0.2</Version>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <ContentTargetFolders>.</ContentTargetFolders>
    <PackageId>MediaWiz.Forums.14</PackageId>
    <Owners>Huw Reddick</Owners>
    <Authors>Huw Reddick</Authors>
    <Product>MediaWiz Forums</Product>
    <Description>MediaWiz Forums for Umbraco</Description>
    <Title>MediaWizard Forums for Umbraco 17</Title>
    <Copyright>Huw Reddick</Copyright>
    <PackageProjectUrl>https://umbraco.themediawizards.co.uk</PackageProjectUrl>
    <PackageTags>umbraco-marketplace umbraco plugin package</PackageTags>
    <RepositoryUrl>https://github.com/huwred/MediaWizForums-14</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageReleaseNotes>Fixes deprecated entryPoint usage</PackageReleaseNotes>
    <PackageIcon>icon.png</PackageIcon>
    <PackageOutputPath>E:\Umbraco-Dev\Nuget</PackageOutputPath>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

<ItemGroup>
    <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.11" />
    <PackageReference Include="Microsoft.Maui.Graphics.Skia" Version="10.0.11" />
    <PackageReference Include="MimeKit" Version="4.15.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
    <PackageReference Include="Umbraco.Cms.Core" Version="17.*" />
	<PackageReference Include="Umbraco.Cms.Examine.Lucene" Version="17.*" />
	<PackageReference Include="Umbraco.Cms.Infrastructure" Version="17.*" />
	<PackageReference Include="Umbraco.Cms.Web.Common" Version="17.*" />
	<PackageReference Include="Umbraco.Cms.Web.Website" Version="17.*" />
</ItemGroup>
	
<ItemGroup>
  <Content Remove="assets\**" />
  <Compile Remove="assets\**" />
  <EmbeddedResource Remove="assets\**" />
  <None Remove="assets\**" />
</ItemGroup>
  
<ItemGroup>
    <None Include="views\**">
      <Pack>true</Pack>
      <PackagePath>Views</PackagePath>
    </None>
    <None Include="build\**">
      <Pack>true</Pack>
      <PackagePath>buildTransitive</PackagePath>
    </None>
	
    <None Include="bundleconfig.json" />
    <None Include="docs\readme.md" Pack="true" PackagePath="\" />
	<None Include="docs\configuration.md" Pack="true" PackagePath="\" />
    <None Include="wwwroot\**" />
	</ItemGroup>
  
<ItemGroup>
  <Compile Remove="Search\LuceneQueryBuilder.cs" />
</ItemGroup>
	
	<ItemGroup>
    <Content Remove="bundleconfig.json" />
    <Content Remove="package-lock.json" />
  </ItemGroup>

	<ItemGroup>
	  <None Remove="views\_ViewStart.cshtml" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Migrations\forumpackage.xml" />
		<EmbeddedResource Include="Migrations\package.xml" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="readme.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
    <None Include=".\icon.png" Pack="true" PackagePath="\" />
		<None Include="appsettings-schema.mediawiz-forums.json" Pack="true" PackagePath="\" />

	</ItemGroup>

</Project>
